{
  "name": "expense-tracker",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspace frontend",
    "test": "npm test --workspace backend",
    "migrate": "npm run migrate --workspace backend",
    "create-admin": "npm run create-admin --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
